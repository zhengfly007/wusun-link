# ============================================================
# Wusn Link — Environment Variable Configuration
# ============================================================
# Copy this to .env and fill in real values before deploying.

# --- WSS Server ---
WSS_PORT=18806
WSS_HOST=0.0.0.0
WSS_TIMEOUT=300000

# --- Singapore (Hermes Brain) ---
# Hermes Agent reads config via process.env — no additional setup needed.

# --- Shanghai (Keen Executor) ---
# WSS Server identifies the Shanghai executor via its public IP
SH_EXECUTOR_IP=your-shanghai-ip-here

# OpenClaw Gateway Token (in Shanghai openclaw.json)
GATEWAY_TOKEN=your-g...here

# --- API Keys ---
# Keen's Tavily Search API Key
TAVILY_API_KEY=tvly-y...here

# Firecrawl API Key (optional)
FIRECRAWL_API_KEY=***

# --- SSH (Optional, for ops scripts) ---
SG_IP=your-singapore-ip
SH_IP=your-shanghai-ip
SSH_USER=your-ssh-username
SSH_PORT=22222

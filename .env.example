# ============================================================
# 无双链路 (Wusn Link) — 环境变量配置
# ============================================================
# 使用前复制为 .env 并填入真实值

# --- WSS Server ---
WSS_PORT=18806
WSS_HOST=0.0.0.0
WSS_TIMEOUT=300000

# --- Singapore (Hermes 大脑) ---
# 不需额外环境变量，Hermes Agent 会通过 process.env 读取

# --- Shanghai (Keen 执行器) ---
# WSS Server 识别上海executor的IP（上海服务器公网IP）
SH_EXECUTOR_IP=your-shanghai-ip-here

# OpenClaw Gateway Token（在上海 openclaw.json 中）
GATEWAY_TOKEN=your-gateway-token-here

# --- API Keys ---
# Keen 的 tavily 搜索 API Key
TAVILY_API_KEY=tvly-your-key-here

# Firecrawl API Key（可选）
FIRECRAWL_API_KEY=your-key-here

# --- SSH（可选，用于一键运维脚本）---
SG_IP=your-singapore-ip
SH_IP=your-shanghai-ip
SSH_USER=your-ssh-username
SSH_PORT=22222
